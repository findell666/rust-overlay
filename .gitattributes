# Normalise line endings: the repository stores LF, Windows checkouts get CRLF where it
# matters. Without this, editing from PowerShell and from WSL produces diffs on every line.
* text=auto eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.png   binary
*.ico   binary
*.json  text eol=lf
